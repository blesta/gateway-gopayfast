<?php
// The payment form is rendered inside the client area, which may be running either
// the bootstrap template (Bootstrap 4, FontAwesome) or meridian (Bootstrap 5, Bootstrap
// Icons). Every class used below exists in both, only the icon set differs.
$icon = (($template ?? 'bootstrap') == 'meridian' ? 'bi bi-lock-fill' : 'fa fa-lock');

// Disable CSRF for this form, it posts to PayFast rather than back to Blesta
$this->Form->setCsrfOptions(['set_on_create' => false]);
$this->Form->create(($post_to ?? null), ['id' => 'gopayfast-payment-form']);

// Set payment fields
if (($fields ?? null)) {
    foreach ($fields as $key => $value) {
        $this->Form->fieldHidden($key, $value);
    }
}
?>
<div class="text-right mt-2">
    <button type="submit" class="btn btn-primary btn-lg">
        <i class="<?php echo $this->Html->safe($icon);?>"></i>
        <?php $this->_('Gopayfast.buildprocess.submit');?>
    </button>
</div>
<p class="text-center mb-0"><small><?php $this->_('Gopayfast.buildprocess.description');?></small></p>
<?php
$this->Form->end();
?>
<script>
(function () {
    var payment_form = document.getElementById('gopayfast-payment-form');

    if (!payment_form) {
        return;
    }

    // How long the client is given to read the page before being sent to PayFast
    var submit_delay = 10000;
    var submitted = false;
    var mark_submitted = function () {
        submitted = true;
    };

    // A client who presses the button first must not be submitted a second time when the
    // timer fires. The page around this form may be jQuery or vanilla, and a submit event
    // does not cross between the two, so listen in both worlds
    payment_form.addEventListener('submit', mark_submitted);

    if (window.jQuery) {
        window.jQuery(payment_form).on('submit', mark_submitted);
    }

    window.setTimeout(function () {
        if (submitted) {
            return;
        }

        // Dispatch a real event rather than calling submit() straight away, so any
        // handler the surrounding page has bound still runs and can cancel the payment
        var submit_event = new Event('submit', {bubbles: true, cancelable: true});

        if (payment_form.dispatchEvent(submit_event)) {
            submitted = true;
            payment_form.submit();
        }
    }, submit_delay);
})();
</script>
